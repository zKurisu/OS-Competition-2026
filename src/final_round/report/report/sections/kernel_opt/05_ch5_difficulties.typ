      ([└ 进入/返回用户态 `enter`], [5 558], [架构层的一整趟往返]),
      ([└ 分派与函数体 `handle`], [2 654], [按调用号查表 + `getpid` 本体]),
      ([└ ptrace 前置检查 `pre`], [264], [每次进入都判一次"是否被跟踪"]),
      ([└ 返回后处理 `post`], [439], [信号与返回前记账]),
      ([其它（用户线侧循环、统计口径）], [1 772], [探针自身与两侧差值]),
