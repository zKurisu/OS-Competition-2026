-    matches!(
-        cmd,
-        SIOCSIWCOMMIT | SIOCSIWFREQ | SIOCSIWMODE | SIOCSIWESSID | SIOCSIWENCODEEXT
-    )
+    (WEXT_FIRST..=WEXT_LAST).contains(&cmd)
